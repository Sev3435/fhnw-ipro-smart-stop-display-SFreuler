        {
          "name": "Get Connections by Transport Type",
          "id": "eb539871-35b8-485f-a962-6f8029698779",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://transport.opendata.ch/v1/connections?from=Zürich&to=Bern&transportations[]=train&limit=4",
              "protocol": "http",
              "host": [
                "transport",
                "opendata",
                "ch"
              ],
              "path": [
                "v1",
                "connections"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "Zürich",
                  "description": "Departure station name or ID"
                },
                {
                  "key": "to",
                  "value": "Bern",
                  "description": "Arrival station name or ID"
                },
                {
                  "key": "transportations[]",
                  "value": "train",
                  "description": "Transport type: train, tram, ship, bus, cableway"
                },
                {
                  "key": "limit",
                  "value": "4",
                  "description": "Number of connections to return (1-16)"
                }
              ]
            },
            "description": "Filter connections by transportation type (train, tram, ship, bus, cableway)."
          },
          "response": []
        },
        {
          "name": "Get Departure Time Only (Smart Display)",
          "id": "10e7d155-2983-4b28-afa4-003b37857a7f",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://transport.opendata.ch/v1/connections?from=Surinam&to=Badischer Bahnhof&limit=1&fields[]=connections/from/departure",
              "protocol": "http",
              "host": [
                "transport",
                "opendata",
                "ch"
              ],
              "path": [
                "v1",
                "connections"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "Surinam",
                  "description": "Departure station name"
                },
                {
                  "key": "to",
                  "value": "Badischer Bahnhof",
                  "description": "Arrival station name"
                },
                {
                  "key": "limit",
                  "value": "1",
                  "description": "Return only the next connection"
                },
                {
                  "key": "fields[]",
                  "value": "connections/from/departure",
                  "description": "Limit response to departure time only"
                }
              ]
            },
            "description": "Optimized request for the Smart Stop Display - returns only the next departure time. Uses the fields parameter to minimize response size for embedded devices."
          },
          "response": []
        }
      ],
      "id": "7b48d4e9-49bc-4dd7-b8a3-d37def5587f6",
      "description": "Endpoints for finding connections between two locations, including departure times, arrival times, and journey details."
