      "description": "Endpoints for searching and finding transport locations, stations, and addresses in Switzerland."
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "Get Connections",
          "id": "0679e848-bf00-4238-9e53-8a4c4a412917",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://transport.opendata.ch/v1/connections?from=Lausanne&to=Genève&limit=4",
              "protocol": "http",
              "host": [
                "transport",
                "opendata",
                "ch"
              ],
              "path": [
                "v1",
                "connections"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "Lausanne",
                  "description": "Departure station name or ID"
                },
                {
                  "key": "to",
                  "value": "Genève",
                  "description": "Arrival station name or ID"
                },
                {
                  "key": "limit",
                  "value": "4",
                  "description": "Number of connections to return (1-16)"
                }
              ]
            },
            "description": "Get the next connections from a departure location to an arrival location. Returns journey details including departure/arrival times and duration."
          },
          "response": []
        },
