          "id": "d4aa7e04-ff0e-44bf-a115-097baecede8c",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://transport.opendata.ch/v1/locations?query=Basel&type=station",
              "protocol": "http",
              "host": [
                "transport",
                "opendata",
                "ch"
              ],
              "path": [
                "v1",
                "locations"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "Basel",
                  "description": "Location name to search for"
                },
                {
                  "key": "type",
                  "value": "station",
                  "description": "Type of location: all, station, poi, address"
                }
              ]
            },
            "description": "Search for locations by name. Returns matching stations, points of interest, or addresses based on the query string."
          },
          "response": []
        },
        {
          "name": "Search Locations by Coordinates",
