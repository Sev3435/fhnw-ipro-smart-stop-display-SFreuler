        </mxCell>
        <mxCell id="qMBHqlze6_dFsUw6lBAo-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p data-start=&quot;212&quot; data-end=&quot;381&quot;&gt;&lt;strong data-start=&quot;212&quot; data-end=&quot;253&quot;&gt;1) Laptop als Proxy (frühe Testphase)&lt;/strong&gt;&lt;br data-start=&quot;253&quot; data-end=&quot;256&quot;&gt;&lt;br&gt;Der ESP32 greift &lt;strong data-start=&quot;273&quot; data-end=&quot;289&quot;&gt;nicht direkt&lt;/strong&gt; auf das Internet zu.&lt;br data-start=&quot;310&quot; data-end=&quot;313&quot;&gt;&lt;br&gt;Der Laptop ruft die API ab und leitet die Daten an den ESP32 weiter.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;383&quot; data-end=&quot;469&quot;&gt;→ Gut für erste Tests und zum Verstehen der Daten&lt;br data-start=&quot;432&quot; data-end=&quot;435&quot;&gt;&lt;br&gt;→ Nicht als finales System gedacht&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;471&quot; data-end=&quot;474&quot;&gt;&lt;br&gt;&lt;p data-start=&quot;476&quot; data-end=&quot;668&quot;&gt;&lt;strong data-start=&quot;476&quot; data-end=&quot;539&quot;&gt;2) ESP32 mit WLAN, Laptop weiterhin als Proxy (Debug-Phase)&lt;/strong&gt;&lt;br data-start=&quot;539&quot; data-end=&quot;542&quot;&gt;&lt;br&gt;Der ESP32 hat WLAN, die API-Abfragen laufen aber noch über den Laptop.&lt;br data-start=&quot;612&quot; data-end=&quot;615&quot;&gt;&lt;br&gt;Der ESP32 verarbeitet nur bereits vorbereitete Daten.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;670&quot; data-end=&quot;726&quot;&gt;→ Einfacheres Debugging&lt;br data-start=&quot;693&quot; data-end=&quot;696&quot;&gt;&lt;br&gt;→ Noch nicht die finale Lösung&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;728&quot; data-end=&quot;731&quot;&gt;&lt;br&gt;&lt;p data-start=&quot;733&quot; data-end=&quot;901&quot;&gt;&lt;strong data-start=&quot;733&quot; data-end=&quot;775&quot;&gt;3) MQTT-Lösung (optionale Architektur)&lt;/strong&gt;&lt;br data-start=&quot;775&quot; data-end=&quot;778&quot;&gt;&lt;br&gt;Ein Server ruft die API ab und verteilt die Daten über einen MQTT-Broker.&lt;br data-start=&quot;851&quot; data-end=&quot;854&quot;&gt;&lt;br&gt;Der ESP32 abonniert die Daten und zeigt sie an.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;903&quot; data-end=&quot;1011&quot;&gt;→ Geeignet für mehrere Geräte&lt;br data-start=&quot;932&quot; data-end=&quot;935&quot;&gt;&lt;br&gt;→ Benötigt einen dauerhaft laufenden Server&lt;br data-start=&quot;978&quot; data-end=&quot;981&quot;&gt;&lt;br&gt;→ Nicht vollständig standalone&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1013&quot; data-end=&quot;1016&quot;&gt;&lt;br&gt;&lt;p data-start=&quot;1018&quot; data-end=&quot;1235&quot;&gt;&lt;strong data-start=&quot;1018&quot; data-end=&quot;1060&quot;&gt;4) Standalone-Lösung (Zielarchitektur)&lt;/strong&gt;&lt;br data-start=&quot;1060&quot; data-end=&quot;1063&quot;&gt;&lt;br&gt;Der ESP32 verbindet sich direkt mit dem WLAN und der API.&lt;br data-start=&quot;1120&quot; data-end=&quot;1123&quot;&gt;&lt;br&gt;Die Daten werden auf dem ESP32 verarbeitet und auf dem Display angezeigt.&lt;br data-start=&quot;1196&quot; data-end=&quot;1199&quot;&gt;&lt;br&gt;Ein Lichtsensor steuert die Anzeige.&lt;/p&gt;&lt;p data-start=&quot;1018&quot; data-end=&quot;1235&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p data-start=&quot;1237&quot; data-end=&quot;1319&quot;&gt;→ Kein Laptop oder Server nötig&lt;br data-start=&quot;1268&quot; data-end=&quot;1271&quot;&gt;&lt;br&gt;→ Vollständig eigenständig&lt;br data-start=&quot;1297&quot; data-end=&quot;1300&quot;&gt;&lt;br&gt;→ Ziel des Projekts&lt;/p&gt;" vertex="1">
          <mxGeometry height="1040" width="1140" x="11.45" y="1160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
