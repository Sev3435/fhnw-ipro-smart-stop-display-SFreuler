        <mxCell id="ON_OxpiIsax7I7BB78dN-74" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;strokeWidth=1;fontSize=24;" value="Option 3" vertex="1">
