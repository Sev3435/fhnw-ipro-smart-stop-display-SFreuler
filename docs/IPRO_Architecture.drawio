        <mxCell id="ON_OxpiIsax7I7BB78dN-68" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;strokeWidth=1;fontSize=24;" value="Option 1" vertex="1">
          <mxGeometry height="30" width="148.55" x="11.45" y="10" as="geometry" />
